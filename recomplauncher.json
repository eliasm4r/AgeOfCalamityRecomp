{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "AgeOfCalamityRecomp",
  "repo": "eliasm4r/AgeOfCalamityRecomp",
  "game": {
    "kind": "folder",
    "label": "Your folder with the Switch base game NSP, the 1.3.0 update NSP, any DLC NSPs and your prod.keys."
  },
  "prepare": {
    "program": ["python/python.exe"],
    "args": ["-u", "{install}/installer/setup.py", "--prepare", "--game-dir", "{game}"],
    "label": "Builds the game from your copy: unpacks it, translates and compiles the game code, then prepares the shaders. 20 to 30 minutes the first time; an update only redoes what changed.",
    "timeout": 14400
  },
  "start": {
    "program": ["dist/windows/AgeOfCalamityRecomp.exe", "dist/steamdeck/AgeOfCalamityRecomp.sh"]
  },
  "requires": ["start", "files.folder"],
  "config": [
    {
      "id": "main",
      "format": "ini",
      "file": [{ "path": "{install}/dist/windows/settings.ini" }, { "path": "{install}/dist/steamdeck/settings.ini" }]
    }
  ],
  "saves": [
    "{install}/dist/windows/profile/save",
    "{install}/dist/windows/settings.ini"
  ],
  "folders": {
    "saves": [{ "path": "{install}/dist/windows/profile/save" }, { "path": "{install}/dist/steamdeck/profile/save" }],
    "backups": [{ "path": "{install}/dist/windows/profile/save-backup" }, { "path": "{install}/dist/steamdeck/profile/save-backup" }],
    "logs": [{ "path": "{install}/dist/windows/logs" }, { "path": "{install}/dist/steamdeck/logs" }]
  },
  "settings": [
    {
      "id": "window", "label": "Window",
      "help": "Fills the whole screen. F11 also switches it.",
      "choices": [
        { "label": "Windowed", "set": { "display/fullscreen": "0" } },
        { "label": "Full screen", "set": { "display/fullscreen": "1" } }
      ],
      "defaults": { "display/fullscreen": "0" }
    },
    {
      "id": "output_res", "label": "Game resolution",
      "help": "Size of the game's picture and interface. 1920 x 1080 is the default. Higher: sharper interface, more GPU load. 1280 x 720 suits the Steam Deck.",
      "choices": [
        { "label": "960 x 540", "set": { "display/output_res": "960x540" } },
        { "label": "1280 x 720", "set": { "display/output_res": "1280x720" } },
        { "label": "1600 x 900", "set": { "display/output_res": "1600x900" } },
        { "label": "1920 x 1080", "set": { "display/output_res": "1920x1080" } },
        { "label": "2560 x 1440", "set": { "display/output_res": "2560x1440" } },
        { "label": "3840 x 2160", "set": { "display/output_res": "3840x2160" } }
      ],
      "defaults": { "display/output_res": "1920x1080" }
    },
    {
      "id": "render_scale", "label": "Render scale",
      "help": "Sharpness of the 3D world, as a percentage of the game resolution. Higher is sharper but lowers FPS. 100 % is full size, 140 % needs about twice the GPU power, 200 % four times. Game keeps the Switch's own size.",
      "choices": [
        { "label": "Game", "set": { "display/render_scale": "game" } },
        { "label": "50 %", "set": { "display/render_scale": "50" } },
        { "label": "60 %", "set": { "display/render_scale": "60" } },
        { "label": "67 %", "set": { "display/render_scale": "67" } },
        { "label": "85 %", "set": { "display/render_scale": "85" } },
        { "label": "100 %", "set": { "display/render_scale": "100" } },
        { "label": "125 %", "set": { "display/render_scale": "125" } },
        { "label": "140 %", "set": { "display/render_scale": "140" } },
        { "label": "150 %", "set": { "display/render_scale": "150" } },
        { "label": "175 %", "set": { "display/render_scale": "175" } },
        { "label": "200 %", "set": { "display/render_scale": "200" } }
      ],
      "defaults": { "display/render_scale": "game" }
    },
    {
      "id": "dynamic_res", "label": "Dynamic resolution",
      "help": "Game: the 3D image gets less sharp for a moment in big fights to keep the frame rate. Off: always sharp, but heavier on the GPU.",
      "choices": [
        { "label": "Game", "set": { "display/dynamic_res": "game" } },
        { "label": "Off (full size)", "set": { "display/dynamic_res": "off" } }
      ],
      "defaults": { "display/dynamic_res": "game" }
    },
    {
      "id": "frame_rate", "label": "Frame rate",
      "help": "Images per second. 30 is the original game, 60 is smoother and uses about twice the CPU. 120 and up are experimental and need a fast monitor.",
      "choices": [
        { "label": "30", "set": { "frame rate/fps_limit": "30" } },
        { "label": "60", "set": { "frame rate/fps_limit": "60" } },
        { "label": "120 (experimental)", "set": { "frame rate/fps_limit": "120" } },
        { "label": "144 (experimental)", "set": { "frame rate/fps_limit": "144" } },
        { "label": "240 (experimental)", "set": { "frame rate/fps_limit": "240" } }
      ],
      "defaults": { "frame rate/fps_limit": "30" }
    },
    {
      "id": "fxaa", "label": "FXAA",
      "help": "Smooths jagged edges and slightly softens detail. Not used while DLSS or FSR 3.1 is on.",
      "choices": [
        { "label": "Off", "set": { "display/fxaa": "0" } },
        { "label": "On", "set": { "display/fxaa": "1" } }
      ],
      "defaults": { "display/fxaa": "1" }
    },
    {
      "id": "dlaa", "label": "DLAA / FSR 3.1",
      "help": "Smooths edges and reduces shimmer in the 3D image. Uses NVIDIA DLSS on RTX cards (the setup downloads it), AMD FSR 3.1 on the others.",
      "choices": [
        { "label": "Off", "set": { "display/dlaa": "0" } },
        { "label": "On", "set": { "display/dlaa": "1" } }
      ],
      "defaults": { "display/dlaa": "0" }
    },
    {
      "id": "dlaa_engine", "label": "Upscaler",
      "help": "Automatic: DLSS if your card supports it, otherwise FSR 3.1. FSR 3.1 works on every graphics card.",
      "choices": [
        { "label": "Automatic", "set": { "display/dlaa_engine": "auto" } },
        { "label": "NVIDIA DLSS", "set": { "display/dlaa_engine": "dlss" } },
        { "label": "AMD FSR 3.1", "set": { "display/dlaa_engine": "fsr3" } }
      ],
      "defaults": { "display/dlaa_engine": "auto" }
    },
    {
      "id": "vsync", "label": "V-Sync",
      "help": "How images reach the screen. Mailbox: smooth with low delay. VSync: no tearing, a little more delay. Immediate: lowest delay, the image can tear.",
      "choices": [
        { "label": "Mailbox", "set": { "display/vk_present": "mailbox" } },
        { "label": "FIFO", "set": { "display/vk_present": "fifo" } },
        { "label": "Immediate", "set": { "display/vk_present": "immediate" } }
      ],
      "defaults": { "display/vk_present": "mailbox" }
    },
    {
      "id": "filtering", "label": "Texture filtering",
      "help": "Keeps the ground and walls sharp in the distance. Game: the same level as on Switch.",
      "choices": [
        { "label": "Game", "set": { "display/aniso": "game" } },
        { "label": "2x", "set": { "display/aniso": "2" } },
        { "label": "4x", "set": { "display/aniso": "4" } },
        { "label": "8x", "set": { "display/aniso": "8" } },
        { "label": "16x", "set": { "display/aniso": "16" } }
      ],
      "defaults": { "display/aniso": "game" }
    },
    {
      "id": "shadow_scale", "label": "Shadow quality",
      "help": "Higher values make shadow edges sharper and use more GPU.",
      "choices": [
        { "label": "1x", "set": { "display/shadow_scale": "1" } },
        { "label": "2x", "set": { "display/shadow_scale": "2" } },
        { "label": "3x", "set": { "display/shadow_scale": "3" } },
        { "label": "4x", "set": { "display/shadow_scale": "4" } }
      ],
      "defaults": { "display/shadow_scale": "1" }
    },
    {
      "id": "soft_shadows", "label": "Soft shadows",
      "help": "Shadows stay sharp near objects and get softer further away. 0 keeps the game's original shadows.",
      "slider": { "key": "display/pcss", "min": 0, "max": 200, "step": 10, "format": "%d" },
      "defaults": { "display/pcss": "0" }
    },
    {
      "id": "color_preset", "label": "Colours",
      "help": "Ready-made colour settings. Vivid: stronger colours and contrast, made for OLED. Clarity: slightly brighter and crisper. Custom uses the four sliders below.",
      "choices": [
        { "label": "Default", "set": { "display/color_preset": "default" } },
        { "label": "Vivid", "set": { "display/color_preset": "vivid" } },
        { "label": "Clarity", "set": { "display/color_preset": "clarity" } },
        { "label": "Custom", "set": { "display/color_preset": "custom" } }
      ],
      "defaults": { "display/color_preset": "default" }
    },
    {
      "id": "brightness", "label": "Brightness",
      "help": "Makes the whole picture lighter or darker. 0 changes nothing.",
      "slider": { "key": "display/color_brightness", "min": -30, "max": 30, "step": 1, "format": "%d" },
      "defaults": { "display/color_brightness": "0" }
    },
    {
      "id": "contrast", "label": "Contrast",
      "help": "Difference between light and dark areas. 100 % changes nothing.",
      "slider": { "key": "display/color_contrast", "min": 70, "max": 150, "step": 5, "format": "%d" },
      "defaults": { "display/color_contrast": "100" }
    },
    {
      "id": "saturation", "label": "Saturation",
      "help": "Strength of the colours. 100 % changes nothing.",
      "slider": { "key": "display/color_saturation", "min": 50, "max": 200, "step": 5, "format": "%d" },
      "defaults": { "display/color_saturation": "100" }
    },
    {
      "id": "gamma", "label": "Gamma",
      "help": "Below 1: brighter shadows and mid-tones. Above 1: darker. 1 changes nothing.",
      "choices": [
        { "label": "0.8", "set": { "display/color_gamma": "0.8" } },
        { "label": "0.9", "set": { "display/color_gamma": "0.9" } },
        { "label": "1.0", "set": { "display/color_gamma": "1" } },
        { "label": "1.1", "set": { "display/color_gamma": "1.1" } },
        { "label": "1.2", "set": { "display/color_gamma": "1.2" } }
      ],
      "defaults": { "display/color_gamma": "1" }
    },
    {
      "id": "overlay", "label": "Performance overlay",
      "help": "Shows the frame rate in the corner. Full adds CPU, GPU, memory and temperatures. F10 changes the mode.",
      "choices": [
        { "label": "Off", "set": { "display/perf_overlay": "off" } },
        { "label": "FPS", "set": { "display/perf_overlay": "fps" } },
        { "label": "Full", "set": { "display/perf_overlay": "full" } }
      ],
      "defaults": { "display/perf_overlay": "off" }
    },
    {
      "id": "console_mode", "label": "Console mode",
      "help": "Makes the game act as if the Switch is docked or in handheld.",
      "choices": [
        { "label": "TV (docked)", "set": { "language/operation_mode": "docked" } },
        { "label": "Handheld", "set": { "language/operation_mode": "handheld" } }
      ],
      "defaults": { "language/operation_mode": "docked" }
    },
    {
      "id": "volume", "label": "Volume",
      "help": "Overall volume of the game.",
      "slider": { "key": "audio/volume", "min": 0, "max": 100, "step": 5, "format": "%d" },
      "defaults": { "audio/volume": "100" }
    },
    {
      "id": "mute_background", "label": "Mute in the background",
      "help": "Silences the game while you are in another window.",
      "choices": [
        { "label": "Off", "set": { "audio/mute_background": "0" } },
        { "label": "On", "set": { "audio/mute_background": "1" } }
      ],
      "defaults": { "audio/mute_background": "0" }
    },
    {
      "id": "audio_surround", "label": "5.1 surround (experimental)",
      "help": "Sends the game's six audio channels to a 5.1 system. Leave off for stereo speakers or headphones.",
      "choices": [
        { "label": "Off", "set": { "audio/audio_surround": "0" } },
        { "label": "On", "set": { "audio/audio_surround": "1" } }
      ],
      "defaults": { "audio/audio_surround": "0" }
    },
    {
      "id": "prompts", "label": "Button prompts",
      "help": "Button icons shown in the game. A button you remap keeps its original icon.",
      "choices": [
        { "label": "Nintendo", "set": { "input/prompts": "nintendo" } },
        { "label": "Xbox", "set": { "input/prompts": "xbox" } },
        { "label": "PlayStation", "set": { "input/prompts": "playstation" } }
      ],
      "defaults": { "input/prompts": "nintendo" }
    },
    {
      "id": "vibration", "label": "Vibration",
      "help": "How strongly the controller vibrates. 0 turns it off.",
      "slider": { "key": "input/rumble_strength", "min": 0, "max": 300, "step": 10, "format": "%d" },
      "defaults": { "input/rumble_strength": "130" }
    },
    {
      "id": "motion", "label": "Motion controls",
      "help": "Aim by tilting the controller (gyroscope).",
      "choices": [
        { "label": "Off", "set": { "input/motion": "0" } },
        { "label": "On", "set": { "input/motion": "1" } }
      ],
      "defaults": { "input/motion": "1" }
    },
    {
      "id": "aim_left_stick", "label": "Aim with the left stick",
      "help": "On: the left stick also aims the bow, as in the original game. Off: only the right stick aims.",
      "choices": [
        { "label": "Off", "set": { "input/aim_left_stick": "0" } },
        { "label": "On", "set": { "input/aim_left_stick": "1" } }
      ],
      "defaults": { "input/aim_left_stick": "0" }
    },
    {
      "id": "gyro_calibration", "label": "Gyro calibration",
      "help": "Corrects the gyroscope's drift measured with Calibrate gyro (F1, Controls tab). Off: raw gyroscope.",
      "choices": [
        { "label": "Off", "set": { "input/gyro_calibration": "0" } },
        { "label": "On", "set": { "input/gyro_calibration": "1" } }
      ],
      "defaults": { "input/gyro_calibration": "1" }
    },
    {
      "id": "stick_deadzone", "label": "Stick dead zone",
      "help": "How far a stick must move before the game notices. Raise it if the character or the camera drifts.",
      "slider": { "key": "input/stick_deadzone", "min": 0, "max": 50, "step": 1, "format": "%d" },
      "defaults": { "input/stick_deadzone": "8" }
    },
    {
      "id": "invert_x", "label": "Invert camera (horizontal)",
      "help": "Mirrors the right stick's horizontal axis.",
      "choices": [
        { "label": "Off", "set": { "input/invert_rx": "0" } },
        { "label": "On", "set": { "input/invert_rx": "1" } }
      ],
      "defaults": { "input/invert_rx": "0" }
    },
    {
      "id": "invert_y", "label": "Invert camera (vertical)",
      "help": "Mirrors the right stick's vertical axis.",
      "choices": [
        { "label": "Off", "set": { "input/invert_ry": "0" } },
        { "label": "On", "set": { "input/invert_ry": "1" } }
      ],
      "defaults": { "input/invert_ry": "0" }
    }
  ]
}
