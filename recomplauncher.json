{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "AgeOfCalamityRecomp",
  "repo": "eliasm4r/AgeOfCalamityRecomp",
  "game": {
    "kind": "folder",
    "label": "Your folder with the Switch base game NSP, the 1.3.0 update NSP, any DLC NSPs and your prod.keys."
  },
  "prepare": {
    "program": ["python/python.exe"],
    "args": ["-u", "{install}/tools/make_build.py", "--prepare", "--game-dir", "{game}"],
    "label": "Builds the game from your copy: unpacks it, translates and compiles the game code, then prepares the shaders. About 30 minutes the first time; an update only redoes what changed.",
    "timeout": 14400
  },
  "start": {
    "program": ["dist/windows/AgeOfCalamityRecomp.exe", "dist/steamdeck/AgeOfCalamityRecomp.sh"]
  },
  "requires": ["start", "files.folder"],
  "config": [
    {
      "id": "main",
      "format": "ini",
      "file": [{ "path": "{install}/dist/windows/settings.ini" }, { "path": "{install}/dist/steamdeck/settings.ini" }]
    }
  ],
  "saves": [
    "{install}/dist/windows/profile/save",
    "{install}/dist/windows/settings.ini"
  ],
  "folders": {
    "saves": [{ "path": "{install}/dist/windows/profile/save" }, { "path": "{install}/dist/steamdeck/profile/save" }],
    "backups": [{ "path": "{install}/dist/windows/profile/save-backup" }, { "path": "{install}/dist/steamdeck/profile/save-backup" }],
    "logs": [{ "path": "{install}/dist/windows/logs" }, { "path": "{install}/dist/steamdeck/logs" }]
  },
  "settings": [
    {
      "id": "window", "label": "Window",
      "help": "Full screen fills the whole screen. F11 switches it at any time.",
      "choices": [
        { "label": "Windowed", "set": { "display/fullscreen": "0" } },
        { "label": "Full screen", "set": { "display/fullscreen": "1" } }
      ],
      "defaults": { "display/fullscreen": "0" }
    },
    {
      "id": "render_scale", "label": "Render scale",
      "help": "Size of the 3D scene relative to the game resolution: higher is sharper and heavier. Game keeps the Switch's own size.",
      "choices": [
        { "label": "Game", "set": { "display/render_scale": "game" } },
        { "label": "50 %", "set": { "display/render_scale": "50" } },
        { "label": "60 %", "set": { "display/render_scale": "60" } },
        { "label": "67 %", "set": { "display/render_scale": "67" } },
        { "label": "85 %", "set": { "display/render_scale": "85" } },
        { "label": "100 %", "set": { "display/render_scale": "100" } }
      ],
      "defaults": { "display/render_scale": "game" }
    },
    {
      "id": "dlaa", "label": "NVIDIA DLAA",
      "help": "Anti-aliasing by NVIDIA DLSS: smooth edges and steady details. Needs an NVIDIA RTX graphics card; the setup downloads the DLSS library.",
      "choices": [
        { "label": "Off", "set": { "display/dlaa": "0" } },
        { "label": "On", "set": { "display/dlaa": "1" } }
      ],
      "defaults": { "display/dlaa": "0" }
    },
    {
      "id": "vsync", "label": "V-Sync",
      "help": "Mailbox: no tearing and little latency. FIFO: classic V-Sync. Immediate: no wait, may tear.",
      "choices": [
        { "label": "Mailbox", "set": { "display/vk_present": "mailbox" } },
        { "label": "FIFO", "set": { "display/vk_present": "fifo" } },
        { "label": "Immediate", "set": { "display/vk_present": "immediate" } }
      ],
      "defaults": { "display/vk_present": "mailbox" }
    },
    {
      "id": "filtering", "label": "Texture filtering",
      "help": "Keeps textures sharp when seen at an angle, such as the ground in the distance.",
      "choices": [
        { "label": "Game", "set": { "display/aniso": "game" } },
        { "label": "2x", "set": { "display/aniso": "2" } },
        { "label": "4x", "set": { "display/aniso": "4" } },
        { "label": "8x", "set": { "display/aniso": "8" } },
        { "label": "16x", "set": { "display/aniso": "16" } }
      ],
      "defaults": { "display/aniso": "game" }
    },
    {
      "id": "shadow_scale", "label": "Shadow quality",
      "help": "Draws the shadows at a multiple of the Switch's size: sharper edges, heavier on the graphics card.",
      "choices": [
        { "label": "1x", "set": { "display/shadow_scale": "1" } },
        { "label": "2x", "set": { "display/shadow_scale": "2" } },
        { "label": "3x", "set": { "display/shadow_scale": "3" } },
        { "label": "4x", "set": { "display/shadow_scale": "4" } }
      ],
      "defaults": { "display/shadow_scale": "1" }
    },
    {
      "id": "soft_shadows", "label": "Soft shadows",
      "help": "Shadows that soften with distance from what casts them. 0 keeps the game's own.",
      "slider": { "key": "display/pcss", "min": 0, "max": 200, "step": 10, "format": "%d" },
      "defaults": { "display/pcss": "0" }
    },
    {
      "id": "color_preset", "label": "Colours",
      "help": "Default is the game's own picture. Vivid and Clarity are tuned looks; Custom uses the four sliders below.",
      "choices": [
        { "label": "Default", "set": { "display/color_preset": "default" } },
        { "label": "Vivid", "set": { "display/color_preset": "vivid" } },
        { "label": "Clarity", "set": { "display/color_preset": "clarity" } },
        { "label": "Custom", "set": { "display/color_preset": "custom" } }
      ],
      "defaults": { "display/color_preset": "default" }
    },
    {
      "id": "brightness", "label": "Brightness",
      "help": "Makes the whole picture lighter or darker. 0 is the original picture.",
      "slider": { "key": "display/color_brightness", "min": -30, "max": 30, "step": 1, "format": "%d" },
      "defaults": { "display/color_brightness": "0" }
    },
    {
      "id": "contrast", "label": "Contrast",
      "help": "Widens or narrows the gap between the dark and the light areas. 100% is the original picture.",
      "slider": { "key": "display/color_contrast", "min": 70, "max": 150, "step": 5, "format": "%d" },
      "defaults": { "display/color_contrast": "100" }
    },
    {
      "id": "saturation", "label": "Saturation",
      "help": "50% is washed out, 200% gives very vivid colours. 100% is the original picture.",
      "slider": { "key": "display/color_saturation", "min": 50, "max": 200, "step": 5, "format": "%d" },
      "defaults": { "display/color_saturation": "100" }
    },
    {
      "id": "gamma", "label": "Gamma",
      "help": "Lightens or darkens the dark areas without burning out the light ones. 1.0 is the original picture.",
      "choices": [
        { "label": "0.8", "set": { "display/color_gamma": "0.8" } },
        { "label": "0.9", "set": { "display/color_gamma": "0.9" } },
        { "label": "1.0", "set": { "display/color_gamma": "1" } },
        { "label": "1.1", "set": { "display/color_gamma": "1.1" } },
        { "label": "1.2", "set": { "display/color_gamma": "1.2" } }
      ],
      "defaults": { "display/color_gamma": "1" }
    },
    {
      "id": "overlay", "label": "Performance overlay",
      "help": "Shows the frame rate, or every figure, in a corner of the window.",
      "choices": [
        { "label": "Off", "set": { "display/perf_overlay": "off" } },
        { "label": "FPS", "set": { "display/perf_overlay": "fps" } },
        { "label": "Full", "set": { "display/perf_overlay": "full" } }
      ],
      "defaults": { "display/perf_overlay": "off" }
    },
    {
      "id": "console_mode", "label": "Console mode",
      "help": "Which Switch mode the game believes it runs in. It draws at the same size in both.",
      "choices": [
        { "label": "TV (docked)", "set": { "language/operation_mode": "docked" } },
        { "label": "Handheld", "set": { "language/operation_mode": "handheld" } }
      ],
      "defaults": { "language/operation_mode": "docked" }
    },
    {
      "id": "volume", "label": "Volume",
      "help": "Volume of the game's sound and music, in percent.",
      "slider": { "key": "audio/volume", "min": 0, "max": 100, "step": 5, "format": "%d" },
      "defaults": { "audio/volume": "100" }
    },
    {
      "id": "mute_background", "label": "Mute in the background",
      "help": "Silences the game while another window is active.",
      "choices": [
        { "label": "Off", "set": { "audio/mute_background": "0" } },
        { "label": "On", "set": { "audio/mute_background": "1" } }
      ],
      "defaults": { "audio/mute_background": "0" }
    },
    {
      "id": "pad_layout", "label": "Button layout",
      "help": "Which button is A. Nintendo: the right one, as on a Switch (circle on a PlayStation controller). Xbox: the bottom one. Automatic: Nintendo for Nintendo and PlayStation controllers, Xbox for the others.",
      "choices": [
        { "label": "Automatic", "set": { "input/pad_layout": "auto" } },
        { "label": "Nintendo (A right)", "set": { "input/pad_layout": "nintendo" } },
        { "label": "Xbox (A bottom)", "set": { "input/pad_layout": "xbox" } }
      ],
      "defaults": { "input/pad_layout": "auto" }
    },
    {
      "id": "vibration", "label": "Vibration",
      "help": "How strong the controller vibrates. 0 turns it off.",
      "slider": { "key": "input/rumble_strength", "min": 0, "max": 300, "step": 10, "format": "%d" },
      "defaults": { "input/rumble_strength": "130" }
    },
    {
      "id": "motion", "label": "Motion controls",
      "help": "Passes the controller's gyroscope to the game.",
      "choices": [
        { "label": "Off", "set": { "input/motion": "0" } },
        { "label": "On", "set": { "input/motion": "1" } }
      ],
      "defaults": { "input/motion": "1" }
    },
    {
      "id": "stick_deadzone", "label": "Stick dead zone",
      "help": "How far a stick must move before the game notices. Raise it if the character or the camera drifts.",
      "slider": { "key": "input/stick_deadzone", "min": 0, "max": 50, "step": 1, "format": "%d" },
      "defaults": { "input/stick_deadzone": "8" }
    },
    {
      "id": "invert_x", "label": "Invert camera (horizontal)",
      "help": "Mirrors the right stick's horizontal axis.",
      "choices": [
        { "label": "Off", "set": { "input/invert_rx": "0" } },
        { "label": "On", "set": { "input/invert_rx": "1" } }
      ],
      "defaults": { "input/invert_rx": "0" }
    },
    {
      "id": "invert_y", "label": "Invert camera (vertical)",
      "help": "Mirrors the right stick's vertical axis.",
      "choices": [
        { "label": "Off", "set": { "input/invert_ry": "0" } },
        { "label": "On", "set": { "input/invert_ry": "1" } }
      ],
      "defaults": { "input/invert_ry": "0" }
    }
  ]
}
